# Copy this to .env and fill in your values
CLAUDE_API_KEY=your-claude-api-key-here

# Database (auto-configured by docker-compose, change only if running outside Docker)
DATABASE_URL=postgresql://jobber:jobber@db:5432/jobber

# Scraping config
SCRAPE_HOURS_OLD=48          # Only fetch jobs posted within this many hours
SCRAPE_RESULTS_PER_TERM=30  # Max results per search term per board
SCRAPE_SCHEDULE_HOUR=7       # Hour to run daily scrape (local time, 24h)
SCRAPE_SCHEDULE_MINUTE=0

# App
APP_TIMEZONE=America/Vancouver
